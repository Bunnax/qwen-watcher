#!/usr/bin/env python3
"""QWEN WATCHER Project Bootstrap - 
Generates complete project""" import os, 
json os.makedirs('qwen-watcher', 
exist_ok=True) os.chdir('qwen-watcher')
# package.json
pkg = { "name": "qwen-watcher", "version": 
    "3.2.0", "description": "QWEN WATCHER - 
    Multi-asset cryptocurrency market 
    intelligence", "main": 
    "qwen-backend.js", "scripts": {"start": 
    "node qwen-backend.js"}, 
    "dependencies": {"ws": "^8.16.0"}, 
    "engines": {"node": ">=18.0.0"}, 
    "license": "MIT"
}
with open('package.json', 'w') as f: 
    json.dump(pkg, f, indent=2)
# .gitignore
with open('.gitignore', 'w') as f: 
    f.write("node_modules/\n.env\n*.log\n.DS_Store\n")
# LICENSE
with open('LICENSE', 'w') as f: 
    f.write("MIT License\n\nCopyright (c) 
    2026 QWEN WATCHER\n")
# README.md
readme = """# QWEN WATCHER v3.2 Multi-asset 
cryptocurrency market intelligence for 
BTC/USD, ETH/USD, SOL/USD.
## Quick Start
Full stack (recommended): cd qwen-watcher 
    npm install node qwen-backend.js
Open http://localhost:8787 Frontend only: 
Open qwen-watcher.html in browser (uses 
REST polling mode).
## Architecture
Frontend (qwen-watcher.html) -> Backend 
(qwen-backend.js) -> Coinbase (live data)
## Live Data
- WebSocket: 
wss://advanced-trade-ws.coinbase.com 
(ticker, heartbeats, market_trades) - REST: 
api.coinbase.com/v3/brokerage/market/tickers, 
candles - No simulated data - real Coinbase 
prices only
## TradingView
Visualization only - BINANCE:BTCUSDT, 
COINBASE:ETHUSD, BINANCE:SOLUSDT
## License
MIT """ with open('README.md', 'w') as f: 
    f.write(readme)
# qwen-backend.js
backend = """// qwen-backend.js - QWEN 
WATCHER backend const http = 
require('http'); const fs = require('fs'); 
const path = require('path'); const { 
WebSocketServer, WebSocket } = 
require('ws'); const PORT = 
process.env.PORT || 8787; const UPSTREAM = 
'wss://advanced-trade-ws.coinbase.com'; 
const PRODUCTS = ['BTC-USD', 'ETH-USD', 
'SOL-USD']; let upstream = null, 
upstreamState = 'IDLE', attempts = 0; 
function log(m) { 
console.log('[qwen-backend] ' + new 
Date().toISOString() + ' ' + m); } function 
proxyCoinbase(cbPath, search, res) {
  fetch('https://api.coinbase.com' + cbPath 
  + search, { headers: { Accept: 
  'application/json' } })
    .then(async function (r) { const body = 
      await r.text(); 
      res.writeHead(r.status, { 
      'Content-Type': 'application/json', 
      'Access-Control-Allow-Origin': '*' 
      });
      res.end(body);
    })
    .catch(function (e) { 
      res.writeHead(502, { 'Content-Type': 
      'application/json' }); 
      res.end(JSON.stringify({ error: 
      String(e) }));
    });
}
const server = http.createServer(function 
(req, res) {
  const u = new URL(req.url, 
  'http://localhost'); if (u.pathname === 
  '/api/health') {
    res.writeHead(200, { 'Content-Type': 
    'application/json' }); 
    res.end(JSON.stringify({ ok: true, 
    upstream: upstreamState })); return;
  }
  if (u.pathname === '/api/tickers') { 
  proxyCoinbase('/api/v3/brokerage/market/tickers', 
  u.search, res); return; } if (u.pathname 
  === '/api/candles') { 
  proxyCoinbase('/api/v3/brokerage/market/candles', 
  u.search, res); return; } let file = 
  u.pathname === '/' ? 'qwen-watcher.html' 
  : 
  decodeURIComponent(u.pathname.replace(/^\\/+/, 
  '')); const fp = path.join(__dirname, 
  file); fs.readFile(fp, function (err, 
  buf) {
    if (err) { res.writeHead(404); 
    res.end('not found'); return; } 
    res.writeHead(200, { 'Content-Type': 
    'text/html' }); res.end(buf);
  });
});
const wss = new WebSocketServer({ server, 
path: '/feed' }); function 
connectUpstream() {
  attempts++; upstreamState = 'CONNECTING'; 
  upstream = new WebSocket(UPSTREAM); 
  upstream.onopen = function () {
    attempts = 0; upstreamState = 'OPEN'; 
    upstream.send(JSON.stringify({ type: 
    'subscribe', product_ids: PRODUCTS, 
    channel: 'ticker', timestamp: new 
    Date().toISOString() })); 
    upstream.send(JSON.stringify({ type: 
    'subscribe', product_ids: PRODUCTS, 
    channel: 'heartbeats', timestamp: new 
    Date().toISOString() })); 
    upstream.send(JSON.stringify({ type: 
    'subscribe', product_ids: PRODUCTS, 
    channel: 'market_trades', timestamp: 
    new Date().toISOString() }));
  };
  upstream.onmessage = function (ev) { 
    const data = typeof ev.data === 
    'string' ? ev.data : 
    ev.data.toString(); for (const client 
    of wss.clients) {
      if (client.readyState === 1) 
      client.send(data);
    }
  };
  upstream.onclose = function () { 
    upstreamState = 'CLOSED'; 
    setTimeout(connectUpstream, 
    Math.min(30000, 1000 * Math.pow(2, 
    Math.min(attempts, 5))));
  };
  upstream.onerror = function (e) { 
  log('ERROR ' + (e.message || '')); };
}
wss.on('connection', function (ws) { 
  ws.send(JSON.stringify({ type: 'hello', 
  service: 'qwen-backend', upstream: 
  UPSTREAM, upstreamState: upstreamState 
  }));
});
server.listen(PORT, function () { 
  log('Backend ready - open 
  http://localhost:' + PORT); 
  connectUpstream();
});
""" with open('qwen-backend.js', 'w') as f: 
    f.write(backend)
print("✓ Base project files created!")
